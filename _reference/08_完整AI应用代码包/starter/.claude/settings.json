{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 -m unittest discover -s tests -v)",
      "Bash(python3 server.py --check)",
      "Bash(python3 tools/classroom_mcp.py --self-test)",
      "Bash(git status *)",
      "Bash(git diff *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(python3 server.py --open)",
      "Bash(python3 server.py --port *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./runtime/private/**)",
      "Read(../golden/**)",
      "Bash(git push *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)"
    ]
  }
}
