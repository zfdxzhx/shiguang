# Only the local Python backend reads these values. Never put a real key in Git.
# Recommended route: Gemini sees the pages once; DeepSeek sees only minimized
# structured text. K3 + DeepSeek remains the domestic-network fallback.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash

# Domestic-network fallback: the earlier three-drawing preflight verified Kimi Code K3 high.
# A sk-kimi Code key is a different product/key/billing path from Kimi Open
# Platform. Do not mix their keys, endpoints or model IDs.
AI_PROVIDER=hybrid
KIMI_API_KEY=
KIMI_MODEL=k3
KIMI_API_BASE=https://api.kimi.com/coding/v1

# Advanced alternative: to use Kimi Open Platform, replace both KIMI_API_BASE
# and KIMI_MODEL with an officially available multimodal endpoint/model ID.

# Optional Google provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Text-only second stage for AI_PROVIDER=hybrid. It never receives images.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional OpenAI provider.
OPENAI_API_KEY=
OPENAI_MODEL=
