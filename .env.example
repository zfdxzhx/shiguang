# 本地密钥配置示例。请复制为 .env.local 并填写真实密钥。
# .env.local 已被 .gitignore 排除，密钥永不进入 Git / 数据库 / 前端 / 日志。

# 视觉 Provider 选择：gemini 或 k3（对应页面里的两组 AI 组合）
AI_PROVIDER=gemini

# Gemini 3.7 Flash（视觉读图）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# K3 high（国产备选，视觉读图）——需要时填写
KIMI_API_KEY=
KIMI_MODEL=k3
KIMI_API_BASE=https://api.kimi.com/coding/v1

# DeepSeek V4 Pro（只复核必要文字，不收图片/PDF/密钥/路径）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
